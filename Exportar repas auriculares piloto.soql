        'GRANADA - RECOGIDAS',
        'VELEZ-MALAGA - REYES CATOLICOS',
        'VELEZ-MALAGA - VIVAR TÉLLEZ',
        'MELILLA',
        'GRANADA - DILAR',
        'BAZA',
        'GUADIX',
        'MOTRIL',
        'MALAGA - ALAMEDA PRINCIPAL 1',
        'GRANADA - CARRERA DE LA VIRGEN 2',
        'GRANADA - DR. OLORIZ 2'
    )
    AND GT_Order__r.GT_CountryCode__c = '002'
    AND GT_Order__r.Status NOT IN ('Cancelled', 'Draft')
ORDER BY 
    GT_Order__r.OrderNumber DESC