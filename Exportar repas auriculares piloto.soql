        'MADRID - SAN DIEGO',
        'MADRID - ALCALÁ 1',
        'MADRID - DONOSTIARRA',
        'MADRID - EMILIO FERRARI',
        'MADRID - DE DON ANTONIO DE ANDRES',
        'JEREZ DE LA FRONTERA - LANCERÍA',
        'DOS HERMANAS - DEL EMIGRANTE',
        'ALCALA DE GUADAIRA',
        'JEREZ DE LA FRONTERA - PORVERA',
        'DOS HERMANAS - ANTONIA DIAZ',
        'MAIRENA DEL ALCOR',
        'OSUNA',
        'LOS PALACIOS Y VILLAFRANCA',
        'EL PUERTO DE SANTA MARIA',
        'CADIZ - BRASIL',
        'SANLUCAR DE BARRAMEDA',
        'SAN FERNANDO - ROSARIO',
        'SAN FERNANDO - SAN RAFAEL',
        'CHICLANA DE LA FRONTERA',
        'ROTA',
        'BARBATE',
        'PUERTO REAL',
        'GRANADA - DR. OLORIZ 1',
        'ANTEQUERA',
