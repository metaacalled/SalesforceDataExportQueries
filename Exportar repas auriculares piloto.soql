// Group 1

SELECT 
    GT_Order__r.OrderNumber,
    GT_Order__r.GT_ShopCode__c,
    GT_Order__r.GT_Shop__r.Name,
    GT_Order__r.GT_StartDateRepair__c,
    GT_Receiving__r.CreatedDate,
    GT_Receiving__r.GT_ReceivingDate__c,
    GT_Order__r.GT_RepairEndDate__c,
    GT_Receiving__r.GT_ReceivingStatus__c,
    GT_Order__r.GT_DeliveryRepair__c
FROM 
    GT_ReceivingItem__c
WHERE 
    GT_Order__r.Type = 'Repair'
    AND GT_Receiving__r.GT_ReceivingDate__c >= 2026-07-09 
    AND GT_Receiving__r.GT_ReceivingDate__c <= 2026-07-14  
    AND GT_Order__r.GT_Shop__r.Name IN (
        'BARCELONA - BALMES',
        'VALENCIA - ESCULPTOR CAPUZ',
        'BARCELONA - DE GUIPÚSCOA',
        'BARCELONA - DIAGONAL',
        'BARCELONA - GAUDI',
        'BARCELONA - GRAN DE SANT ANDREU 2',
        'BARCELONA - VIA JULIA',
        'BARCELONA - DE FABRA I PUIG',
        'VALENCIA - SAN AGUSTIN',
        'BARCELONA - PERE IV',
        'MISLATA - GREGORIO GEA 1',
        'PUERTO DE SAGUNTO',
        'VALENCIA - PEREZ GALDOS',
        'RIBARROJA',
        'SANT ADRIA DE BESOS',
        'SAGUNTO',
        'BARCELONA - CASP',
        'VALENCIA - MANUEL CANDELA',
        'VALENCIA - PRIMADO REIG 2',
        'BURJASSOT',
        'BARCELONA - SANT ANTONI Mª CLARET',
        'BARCELONA - GRAN DE SANT ANDREU 1',
        'VALENCIA - AUSIAS MARCH',
        'BARCELONA - PI I MARGALL',
        'MONCADA',
        'VALENCIA - PRIMADO REIG 1',
        'LA ELIANA',
        'BARCELONA - GRAN DE GRACIA',
        'VALENCIA - SERRERIA',
        'VALENCIA - CARTEROS',
        'VALENCIA - DEL CID',
        'BENIMAMET',
        'BARCELONA - MUNTANER',
        'VALENCIA - RUZAFA',
        'MASSAMAGRELL',
        'VALENCIA - DR. PESET'
    )
    AND GT_Order__r.GT_CountryCode__c = '002'
    AND GT_Order__r.Status NOT IN ('Cancelled', 'Draft')
ORDER BY 
    GT_Order__r.OrderNumber DESC

// Group 2

SELECT 
    GT_Order__r.OrderNumber,
    GT_Order__r.GT_ShopCode__c,
    GT_Order__r.GT_Shop__r.Name,
    GT_Order__r.GT_StartDateRepair__c,
    GT_Receiving__r.CreatedDate,
    GT_Receiving__r.GT_ReceivingDate__c,
    GT_Order__r.GT_RepairEndDate__c,
    GT_Receiving__r.GT_ReceivingStatus__c,
    GT_Order__r.GT_DeliveryRepair__c
FROM 
    GT_ReceivingItem__c
WHERE 
    GT_Order__r.Type = 'Repair'
    AND GT_Receiving__r.GT_ReceivingDate__c >= 2026-07-09 
